# Switchboard configuration (spec §4). Copy to volumes/config/.env for local development.
# Secrets may also be supplied as files: set <NAME>_FILE to the file path.

SWITCHBOARD_DATABASE_PATH=./volumes/data/switchboard.sqlite3
# Empty = log to stdout only.
SWITCHBOARD_LOG_DIR=./volumes/logs

# From @BotFather. Prefer SWITCHBOARD_BOT_TOKEN_FILE in production.
SWITCHBOARD_BOT_TOKEN=123456789:replace-with-your-bot-token
# Your numeric Telegram user id, and the private chat id (same number for a DM).
SWITCHBOARD_TELEGRAM_USER_ID=123456789
SWITCHBOARD_TELEGRAM_CHAT_ID=123456789

# JSON map of source name -> bearer token (>= 32 chars, distinct per source).
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Prefer SWITCHBOARD_PRODUCER_KEYS_FILE=/volumes/config/producers.json in production.
# Keep the single quotes: this file is sourced by the shell (README Quick start),
# which would otherwise strip the inner double quotes and break the JSON.
SWITCHBOARD_PRODUCER_KEYS='{"research":"replace-with-a-long-random-token-0001"}'

SWITCHBOARD_TEST_SERVICE_URL=http://127.0.0.1:8081
# SWITCHBOARD_TEST_SERVICE_TOKEN=

SWITCHBOARD_BIND_HOST=127.0.0.1
SWITCHBOARD_BIND_PORT=8080

# Optional tuning / testing
# SWITCHBOARD_POLL_TIMEOUT=30
# SWITCHBOARD_TELEGRAM_API_BASE=https://api.telegram.org
