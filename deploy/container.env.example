# Non-secret settings for deploy/podman.sh. Copy to volumes/config/container.env.
# podman --env-file format: KEY=VALUE, no quotes, no shell expansion.
# Secrets are NOT set here: they come from volumes/config/bot_token and
# volumes/config/producers.json. Paths, bind address and the test service URL
# are fixed by podman.sh.

# Your numeric Telegram user id, and the private chat id (same number for a DM).
SWITCHBOARD_TELEGRAM_USER_ID=123456789
SWITCHBOARD_TELEGRAM_CHAT_ID=123456789

# Optional
# SWITCHBOARD_TEST_SERVICE_TOKEN=
# SWITCHBOARD_POLL_TIMEOUT=30
# SWITCHBOARD_TELEGRAM_API_BASE=https://api.telegram.org
